#!/usr/bin/env bash
# Pre-commit hook — blocks git commit without a recorded HITL approval.
#
# To enable: cp .githooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#
# Before committing:
#   1. Create an approval file under 10_SECURITY/hitl-approvals/ (see README there)
#   2. Run: HITL_APPROVAL=10_SECURITY/hitl-approvals/<file>.md git commit -m "..."

set -euo pipefail

APPROVAL_REF="${HITL_APPROVAL:-}"

if [[ -z "$APPROVAL_REF" ]]; then
  echo "PRE-COMMIT HITL BLOCKED: HITL_APPROVAL environment variable not set." >&2
  echo "  Create an approval file under 10_SECURITY/hitl-approvals/ and run:" >&2
  echo "    HITL_APPROVAL=10_SECURITY/hitl-approvals/<file>.md git commit -m \"...\"" >&2
  exit 1
fi

exec scripts/hitl-gate.sh commit "$APPROVAL_REF"
