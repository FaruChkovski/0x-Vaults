#!/usr/bin/env bash
# Pre-push hook — blocks git push without a recorded HITL approval.
#
# To enable: cp .githooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
#
# Before pushing:
#   1. Create an approval file under 10_SECURITY/hitl-approvals/ (see README there)
#   2. Run: HITL_APPROVAL=10_SECURITY/hitl-approvals/<file>.md git push

set -euo pipefail

APPROVAL_REF="${HITL_APPROVAL:-}"

if [[ -z "$HITL_APPROVAL" ]]; then
  echo "PRE-PUSH HITL BLOCKED: HITL_APPROVAL environment variable not set." >&2
  echo "  Create an approval file under 10_SECURITY/hitl-approvals/ and run:" >&2
  echo "    HITL_APPROVAL=10_SECURITY/hitl-approvals/<file>.md git push" >&2
  exit 1
fi

exec scripts/hitl-gate.sh push "$HITL_APPROVAL"
